# 監聽的埠號
PORT=8787

# SQLite 檔案位置（相對路徑以 server/ 為基準）
DB_PATH=./data/sync.db

# 允許跨來源存取的前端網址，逗號分隔。
# 前端用 python -m http.server 8123 跑的話就是下面這兩個。
# 設成 * 代表不限制（只建議在本機開發時用）。
CORS_ORIGINS=http://localhost:8123,http://127.0.0.1:8123,http://localhost:8124,http://127.0.0.1:8124

# 登入後的 token 有效天數
SESSION_DAYS=180

# 設成 1 之後就不能再註冊新帳號（自己用的話，註冊完就關掉）
DISABLE_REGISTRATION=0
